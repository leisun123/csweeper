{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CSweeper",
  "version": "0.1.0",
  "identifier": "com.csweeper.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CSweeper · C盘清道夫",
        "width": 1080,
        "height": 780,
        "minWidth": 880,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
